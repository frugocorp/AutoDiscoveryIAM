<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Caché propia: una versión repetida del paquete no se confunde con la de tu caché global. -->
    <add key="globalPackagesFolder" value="../packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
