# CheckId: RCS1036
# Category: Formatting
# Severity Default: Info
# Cause: Se detecta una línea en blanco innecesaria en el código fuente.
# Description: Esta regla detectaba líneas vacías redundantes, pero está obsoleta.
# Example:
#   public class Foo
#   {
#
#       private string _f;
#
#
#       public bool Bar()
#       {
#
#           return false;
#
#       }
#   }
# Exception: No aplica, ya que la regla está obsoleta.
# Recomendation: Se desactiva porque la validación se realiza ahora con SA1507 de StyleCop.
dotnet_diagnostic.RCS1036.severity = none

# CheckId: RCS1037
# TypeName: RCS1037RemoveTrailingWhiteSpace
# Category: Analyzers
# Severity Default: Info (suggestion)
# Cause: El código contiene espacios en blanco al final de una línea.
# Description: Recomienda eliminar los espacios o tabulaciones al final de las líneas para mantener el código limpio y consistente.
# Example:
#   // Incorrecto (espacio al final)
#   int x = 1;␣
#   // Correcto
#   int x = 1;
# Excepción: No aplica.
# Recomendation: Mantener activa para asegurar un formato de código profesional y evitar cambios innecesarios en control de versiones.
dotnet_diagnostic.RCS1037.severity = warning

# CheckId: RCS1213
# TypeName: RCS1213RemoveUnusedMemberDeclaration
# Category: Analyzers
# Severity Default: Info (suggestion)
# Cause: Hay miembros declarados en el código que no se utilizan en ninguna parte.
# Description: Recomienda eliminar miembros (métodos, propiedades, campos, etc.) que no tienen referencias para mantener el código limpio y fácil de mantener.
# Example:
#   // Incorrecto
#   private void MetodoNoUsado() { }
# Excepción: Puede omitirse en código generado o para miembros reservados para futuras implementaciones.
# Recomendation: Sugerida para mantener el código libre de elementos innecesarios.
dotnet_diagnostic.RCS1213.severity = warning

# CheckId: RCS1174
# Status: Activo
# Analyzer: Roslynator.Analyzers
# Link: https://josefpihrt.github.io/docs/roslynator/analyzers/RCS1174/
# Last reviewed: 2025-05-20
# LastMerged: null
# TypeName: RCS1174RemoveRedundantAsyncAwait
# Category: Performance
# Subcategory: Async
# C#IntroducedVersion: -
# .NetIntroducedVersion: -
# VisualStudioIntroducedVersion: VS 2022, VS Code, Open VSX
# Default option value: disabled by default
# Cause: El uso de async/await es redundante si el método solo retorna directamente el resultado de otra tarea asíncrona.
# Description: Esta regla detecta y sugiere eliminar el uso innecesario de async/await cuando un método asíncrono simplemente retorna el resultado de otra llamada asíncrona, mejorando la claridad y el rendimiento.
# Example:
#   // Incorrecto
#   public static async Task<object> FooAsync()
#   {
#       return await GetAsync().ConfigureAwait(false);
#   }
#   // Correcto
#   public static Task<object> FooAsync()
#   {
#       return GetAsync();
#   }
# Exception: Puede omitirse la corrección si se requiere await para manejo de excepciones o lógica adicional.
# Recommendation: Elimina async/await redundantes para mejorar la claridad y eficiencia, excepto cuando sea necesario para el control de flujo o manejo de errores.
# Justification: Se desactiva ya que agregar las palabras reservadas async/await es la forma recomendada, segura, y más legible para trabajar con operaciones asíncronas, pero debe evitarse el uso redundante.
dotnet_diagnostic.RCS1174.severity = none

# CheckId: RCS1220
# TypeName: RCS1220UsePatternMatchingInsteadOfCombinationOfIsOperatorAndCastOperator
# Category: Analyzers
# Severity Default: Info (suggestion)
# Cause: Se utiliza una combinación del operador 'is' y un casteo explícito en vez de pattern matching.
# Description: Recomienda usar pattern matching para simplificar el código y mejorar la legibilidad cuando se verifica el tipo y luego se realiza un cast.
# Example:
#   // Incorrecto
#   if (x is T && Foo((T)x))
#   {
#   }
#   // Correcto
#   if (x is T y && Foo(y))
#   {
#   }
# Excepción: Puede omitirse si se requiere compatibilidad con versiones anteriores a C# 7.0.
# Recomendation: Mantener activa para aprovechar las características modernas del lenguaje y mejorar la claridad.
dotnet_diagnostic.RCS1220.severity = suggestion


# CheckId: RCS1077
# TypeName: RCS1077OptimizeLinqMethodCall
# Category: Analyzers
# Severity Default: Info
# Cause: Se utiliza una combinación de métodos LINQ que puede ser optimizada.
# Description: Sugiere reemplazar combinaciones de métodos LINQ por alternativas más directas y eficientes, como usar Any(predicate) en lugar de Where(predicate).Any().
# Example:
#   // Incorrecto: Buscar si algún post es publicado usando Where + Any
#   bool hayPublicados = posts.Where(p => p.IsPublished).Any();
#   // Correcto: Usar Any con predicado directamente
#   bool hayPublicados = posts.Any(p => p.IsPublished);
# Excepción: Puede omitirse si la claridad del flujo es prioritaria en casos específicos.
# Recomendation: Sugerida para mejorar la eficiencia y claridad en consultas LINQ.
dotnet_diagnostic.RCS1077.severity = warning

# CheckId: RCS1118
# TypeName: RCS1118MarkLocalVariableAsConst
# Category: Analyzers
# Severity Default: Info
# Cause: Una variable local puede ser declarada como const porque su valor no cambia.
# Description: Recomienda marcar variables locales como const cuando su valor es constante, para mejorar la claridad, seguridad y optimización del código.
# Example:
#   // Incorrecto
#   string s = "a";
#   string s2 = s + "b";
#   // Correcto
#   const string s = "a";
#   string s2 = s + "b";
# Excepción: Puede omitirse si la variable debe ser reasignada en el futuro.
# Recomendation: Mantener activa para promover buenas prácticas y evitar variables mutables innecesarias.
dotnet_diagnostic.RCS1118.severity = warning

# CheckId: RCS1129
# Status: Activo
# Analyzer: Roslynator
# Link: https://josefpihrt.github.io/docs/roslynator/analyzers/RCS1129/
# Last reviewed: null
# LastMerged: null
# TypeName: RCS1129
# Category: null
# Subcategory: null
# C#IntroducedVersion: null
# .NetIntroducedVersion: null
# VisualStudioIntroducedVersion : null
# Default option value: Hidden
# Cause: Inicialización redundante de un campo al valor predeterminado de su tipo.
# Description: Indica que un campo está siendo inicializado explícitamente a su valor predeterminado, lo cual es innecesario porque el compilador ya lo hace automáticamente.
# Example:
#   // Incorrect
#   private bool _f = false;
#   // Correct
#   private bool _f;
# Exception: null
# Recomendation: Eliminar inicializaciones explícitas a valores predeterminados, salvo que se requiera para mejorar la claridad o el entendimiento visual del código por parte del equipo.
# Justification: Mismo efecto que CA1805; en este proyecto también se decide desactivar, ya que se prefiere declarar valores predeterminados para facilitar el entendimiento visual del código.
dotnet_diagnostic.RCS1129.severity = none

