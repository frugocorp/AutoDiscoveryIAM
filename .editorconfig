###############################################################################

# Para desactivar todas las reglas de Meziantou 
# Hay que agregar esto al *.csproj o *.props segun sea el caso.
# Según la documentación, solo acepta Default y None:
#
# <!-- Meziantou: se desactivan todas las reglas para activar las necesarias -->
# <MeziantouAnalysisMode>None</MeziantouAnalysisMode>

# CheckId: MA0016
# TypeName: MA0016PreferCollectionAbstraction
# Category: Design
# Severity Default: Warning
# Cause: Se utiliza una implementación concreta de colección (ej. List<T>, Dictionary<TKey, TValue>) en la API pública en vez de una abstracción (ej. IEnumerable<T>, ICollection<T>).
# Description: Promueve el uso de interfaces de colección en firmas públicas para mejorar la flexibilidad y mantenibilidad del código.
# Example:
#   public List<string> Prop { get; set; } // non-compliant
#   public IList<string> Prop { get; set; } // ok
# Excepción: Puede omitirse en APIs internas o cuando se requiere una funcionalidad específica de la implementación.
# Recomendation: Usar interfaces en parámetros y retornos públicos, y limitar implementaciones concretas al ámbito privado.
dotnet_diagnostic.MA0016.severity = warning

# CheckId: MA0032
# TypeName: MA0032UseCancellationTokenOverload
# Category: Usage
# Severity Default: Info (none)
# Cause: El método asíncrono llamado tiene una sobrecarga que acepta un CancellationToken, pero no se utiliza.
# Description: Promueve el uso de métodos asíncronos que aceptan CancellationToken para permitir la cancelación adecuada de operaciones.
# Example:
#   // Incorrecto
#   await httpClient.GetAsync("url");
#   // Correcto
#   await httpClient.GetAsync("url", cancellationToken);
# Excepción: Puede omitirse si no existe una sobrecarga con CancellationToken o en código donde la cancelación no es relevante.
# Recomendation: Siempre que sea posible, utiliza la versión del método que acepte CancellationToken para mejorar la robustez y control del flujo asíncrono.
dotnet_diagnostic.MA0032.severity = warning

# CheckId: MA0051
# TypeName: MA0051MethodIsTooLong
# Category: Design
# Severity Default: Warning
# Cause: El método excede la cantidad máxima recomendada de líneas o sentencias.
# Description: Limita la longitud de los métodos para mejorar la legibilidad, mantenibilidad y facilitar las pruebas.
# Example:
#   // Incorrecto: método con más de XX líneas o YY sentencias.
#   void MetodoLargo() {
#       // ... muchas líneas o sentencias ...
#   }
# Excepción: Puede omitirse usando SuppressMessageAttribute, pero solo en caso de no poder refactorizar más.
# Recomendation: Refactoriza métodos largos dividiéndolos en funciones más pequeñas y reutilizables.

dotnet_diagnostic.MA0051.severity = warning
# Máximo de líneas permitidas por método (default: 60)
MA0051.maximum_lines_per_method = 50
# Máximo de sentencias permitidas por método (default: 40) 
MA0051.maximum_statements_per_method = 30
# Considerar funciones locales al contar sentencias (default: false)  
MA0051.skip_local_functions = false
# Parametros para EndPoints
[**/*EndPoint.cs]
MA0051.maximum_lines_per_method = 200
MA0051.maximum_statements_per_method = 100
[**/*Middleware.cs]
MA0051.maximum_lines_per_method = 100
MA0051.maximum_statements_per_method = 50
[**/*Tests.cs]
MA0051.maximum_lines_per_method = 200
MA0051.maximum_statements_per_method = 100
[**/*Configuration.cs]
MA0051.maximum_lines_per_method = 100
MA0051.maximum_statements_per_method = 50
[**/Migrations/*.cs]
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.CA1861.severity = none
[**/Seeds/*.cs]
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.CA1861.severity = none
[*.cs]
# VisualStudioIntroducedVersion : null
# Default option value: none
# Cause: Un campo de una clase se inicializa explícitamente al valor predeterminado del tipo de ese campo.
# Description: El entorno de ejecución de .NET inicializa todos los campos de tipos de referencia a sus valores predeterminados antes de ejecutar el constructor. Inicializar explícitamente un campo a su valor predeterminado es redundante, agrega costos de mantenimiento y puede degradar el rendimiento.
# Example:
#   // Incorrect
#   int _value1 = 0;
#   // Correct
#   int _value1;
# Exception: Esta advertencia se puede suprimir, ya que solo señala código potencialmente innecesario y no afecta la funcionalidad.
# Recomendation: Eliminar inicializaciones explícitas a valores predeterminados, excepto cuando se requiera para mejorar la claridad o el entendimiento visual del código por parte del equipo.
# Justification: Por default se encuentra deshabilitada en .NET 9; en este proyecto también se decide desactivar, ya que se prefiere declarar valores predeterminados para facilitar el entendimiento visual del código.
dotnet_diagnostic.CA1805.severity = none

