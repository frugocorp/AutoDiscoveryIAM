# DOCKER_APP_WEB

# Sin APP_PORT_HOST/APP_PORT_MAP a proposito -- este stack no publica ningun puerto al host (ver
# docker-compose.yml), asi que solo hace falta el puerto interno del contenedor.
APP_PORT_CONTAINER=

# Nombre real del contenedor en la red compartida (ver container_name en docker-compose.yml) --
# cualquier otro stack que necesite alcanzar este contenedor (ej. nginx-server-docker, su propia variable
# APP_CONTAINER_NAME) debe usar este mismo valor. Sugerido: "<proyecto>-app-web".
APP_CONTAINER_NAME=

APP_BUILD_CONTEXT=
APP_DOCKERFILE_PATH=
# Feed local de npm (equivalente a NUGET_LOCAL_FEED_PATH en docker/api) -- carpeta con paquetes
# propios empaquetados via "npm pack" que package.json referencia como "file:./vendor/..." en vez
# de la version publicada. Si tu proyecto no usa ninguno, apunta a una carpeta vacia (ver
# Dockerfile, build context "npmfeed").
APP_NPM_FEED_PATH=
# Solo la etapa "dev" del Dockerfile la usa (COPY de dev-entrypoint.sh) -- relativa a
# APP_BUILD_CONTEXT, igual que APP_DOCKERFILE_PATH. Parametrizada porque una copia de esta carpeta
# anidada mas profundo que "docker/app/web/" (ej. "docker/app/web/<sitio>/") cambia esta ruta
# aunque el Dockerfile sea byte a byte identico. Sugerido: "./docker/app/web/dev-entrypoint.sh".
APP_DEV_ENTRYPOINT_PATH=
APP_PROJECT_PATH=
APP_PROJECT_NAME=

# Lista separada por comas de hosts permitidos (proteccion SSRF nativa de Angular 22+, ver
# angular.dev/best-practices/security) -- debe incluir el dominio real que usa nginx como proxy
# reverso (nginx-server-docker/.env, APP_SERVER_NAME). Este stack ya no publica ningun puerto al host
# (ver docker-compose.yml), asi que no hace falta agregar "localhost" aqui para pruebas directas --
# la unica forma de llegar a este contenedor es por nginx, que ya manda el Host correcto. Nunca
# uses "*", desactiva la proteccion por completo. Duplicado a mano respecto al dominio de
# nginx-server-docker/.env a proposito -- son dos stacks de Docker independientes, sin variables
# compartidas entre si.
#
# OJO: NO agregues "*.tu-dominio" aqui salvo que esta misma app SSR realmente vaya a responder en
# algun subdominio -- si los subdominios los sirve otro template/contenedor (ej. docker/api/),
# nginx nunca reenvia esos requests hacia aqui. Un wildcard de mas solo amplia lo que este
# servidor aceptaria si alguien lo alcanzara directo con un Host falsificado, sin ningun beneficio
# real.
APP_ALLOWED_HOSTS=

# "static" (SSG, nginx sirviendo dist/browser, sin Node en runtime) o "server" (SSR completo,
# node server.mjs) -- DEBE coincidir con el "outputMode" que angular.json del sitio ya tiene.
APP_RENDER_MODE=static
# Solo se usa (se copia) cuando APP_RENDER_MODE=static -- ver Dockerfile, etapa final-static.
APP_NGINX_STATIC_CONF_PATH=./docker/app/web/nginx-static.conf.template
