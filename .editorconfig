# Desactivamos todas las reglas de esta categoría para ir personalizando
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = suggestion

# CheckId: SA1600
# TypeName: SA1600ElementsMustBeDocumented
# Category: Documentation Rules
# Severity Default: Warning
# Cause: Falta documentación XML en elementos públicos.
# Description: Obliga a documentar con comentarios XML todas las clases, métodos y propiedades públicas.
# Example: /// <summary>Mi método</summary>
# Excepción: Desactivada para no requerir documentación XML obligatoria.
# Recomendation: Mantener desactivada si se prefiere documentación opcional.
dotnet_diagnostic.SA1600.severity = suggestion

# CheckId: SA1642
# TypeName: SA1642ConstructorSummaryDocumentationMustBeginWithStandardText
# Category: Documentation Rules
# Severity Default: Warning
# Cause: El comentario de resumen (summary) de un constructor no inicia con el texto estándar recomendado.
# Description: Obliga a que la documentación XML de los constructores comience con "Initializes a new instance of the {nombreClase} class." para mantener coherencia y claridad en la documentación pública.
# Example:
#   /// <summary>
#   /// Initializes a new instance of the MiClase class.
#   /// </summary>
# Excepción: Puede desactivarse si el equipo prefiere un estilo de documentación distinto o más flexible.
# Recomendation: Mantener desactivada si la documentación estándar no es requerida por el equipo.
# Justification: Se está documentando con texto libre.
dotnet_diagnostic.SA1642.severity = none

