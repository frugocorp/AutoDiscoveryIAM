# DOCKER_API

ASPNETCORE_ENVIRONMENT=
# Sin API_PORT_HOST/API_PORT_MAP a proposito -- este stack no publica ningun puerto al host (ver
# docker-compose.yml), asi que solo hace falta el puerto interno del contenedor.
API_PORT_CONTAINER=

API_BUILD_CONTEXT=
API_DOCKERFILE_PATH=
API_PROJECT_PATH=
API_PROJECT_NAME=
# Solo si tu AssemblyName (.csproj) difiere del nombre del proyecto -- si coinciden, deja vacio
# (el Dockerfile usa API_PROJECT_NAME como default para la .dll a ejecutar).
API_ASSEMBLY_NAME=

# Carpeta con paquetes NuGet propios que aun no estan publicados en un feed remoto -- si no
# aplica (como en este mismo ejemplo, que usa ProjectReference en vez de PackageReference),
# apunta a una carpeta vacia (ej. ./local-nuget-feed) para que el build no falle por un contexto
# adicional inexistente.
NUGET_LOCAL_FEED_PATH=

# La base de datos no vive en este docker-compose (a proposito, ver docker/README.md): apunta
# ConnectionStrings__DefaultConnection (appsettings.json o variable de entorno) a tu propia
# instancia de SQL Server.
