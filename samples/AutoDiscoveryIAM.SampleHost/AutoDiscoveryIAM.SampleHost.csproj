<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FrugoCorp.AspNetCore.AutoDiscoveryIAM.SampleHost</RootNamespace>
    <AssemblyName>FrugoCorp.AspNetCore.AutoDiscoveryIAM.SampleHost</AssemblyName>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoDiscoveryIAM\AutoDiscoveryIAM.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Elección de renderizador de este host: intercambiable por Scalar/ReDoc/Mintlify/etc. sin
         tocar nada de la librería, ver Common/Swagger/EndpointOperationDocs.cs. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.15" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="[10.2.3]" />
    <!-- Este host elige SQL Server como proveedor. La librería no trae ningún proveedor concreto,
         solo el paquete base de EF Core. Otro proyecto consumidor referenciaría Npgsql/Sqlite/etc.
         en su lugar. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!-- Microsoft.Data.SqlClient arrastra Pkcs 9.0.4, con vulnerabilidades publicadas (GHSA-846f-f764-76mx,
         GHSA-2fmv-rv2c-59x7). Se fija la version corregida; quitar cuando SqlClient la traiga por si solo. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Requerido para "dotnet ef": este proyecto ahora es dueño de sus propias migraciones
         (Migrations/, generadas contra ApplicationDbContext de la librería), así que necesita
         Microsoft.EntityFrameworkCore.Design directamente. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
